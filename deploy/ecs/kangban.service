[Unit]
Description=Kangban server
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/kangban
EnvironmentFile=/opt/kangban/kangban.env
ExecStart=/usr/local/amazon-corretto-25.0.3.9.1-linux-x64/bin/java -jar /opt/kangban/kangban-server.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
