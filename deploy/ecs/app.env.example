# Kangban production environment. Copy to /opt/kangban/kangban.env on ECS.
# Replace every placeholder value locally on the server. Never commit the copied file.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081

KANGBAN_DB_URL=jdbc:mysql://127.0.0.1:3306/kangban?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
KANGBAN_DB_USERNAME=kangban_app
KANGBAN_DB_PASSWORD=CHANGE_ME_DB_PASSWORD

KANGBAN_REDIS_HOST=127.0.0.1
KANGBAN_REDIS_PORT=6379
KANGBAN_REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

KANGBAN_MINIO_ENDPOINT=http://127.0.0.1:9000
KANGBAN_MINIO_ACCESS_KEY=kangban_minio
KANGBAN_MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
KANGBAN_MINIO_BUCKET=kangban-files

APP_BASE_URL=http://8.140.199.38
APP_CORS_ALLOWED_ORIGINS=http://8.140.199.38
KANGBAN_CAPTCHA_SECRET=CHANGE_ME_CAPTCHA_SECRET

APP_AI_PROVIDER=qwen
APP_AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
APP_AI_API_KEY=CHANGE_ME_AI_API_KEY
APP_AI_AI_MODEL=qwen3.7-plus-2026-05-26
APP_AI_OCR_MODEL=qwen3.5-ocr
APP_AI_CONNECT_TIMEOUT=10000
APP_AI_READ_TIMEOUT=120000

APP_AGENT_ENABLED=true
APP_AGENT_MODEL_TOOL_CALLING_ENABLED=false
APP_AGENT_CONTEXT_TTL_SECONDS=300
APP_AGENT_MAX_ITERATIONS=5
APP_AGENT_MAX_HISTORY_MESSAGES=12
APP_AGENT_MAX_HISTORY_TOKENS=6000
APP_AGENT_MAX_HISTORY_MESSAGE_CHARACTERS=4000
APP_AGENT_CORE_POOL_SIZE=4
APP_AGENT_MAX_POOL_SIZE=8
APP_AGENT_QUEUE_CAPACITY=40
APP_AGENT_CONTEXT_SECRET=CHANGE_ME_AGENT_CONTEXT_SECRET
APP_RAG_ENABLED=true
APP_RAG_PRIVATE_ENABLED=true
APP_RAG_VECTOR_STORE=mysql-jdbc
APP_RAG_TOP_K=5
APP_RAG_MIN_SCORE=0.7
APP_RAG_MAX_CONTEXT_TOKENS=6000
APP_KNOWLEDGE_ADMIN_TOKEN=CHANGE_ME_KNOWLEDGE_ADMIN_TOKEN
APP_RAG_EMBEDDING_PROVIDER=qwen
APP_RAG_EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
APP_RAG_EMBEDDING_MODEL=text-embedding-v4
APP_RAG_EMBEDDING_DIMENSIONS=1024
APP_RAG_EMBEDDING_BATCH_SIZE=16
APP_RAG_MAX_FILE_BYTES=10485760

KANGBAN_JWT_SECRET=CHANGE_ME_JWT_SECRET
KANGBAN_JWT_EXPIRATION=86400000
KANGBAN_JWT_REFRESH_EXPIRATION=604800000
