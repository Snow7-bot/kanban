# Configure these values in the IDE run configuration or the local shell.
# Never commit or share real credentials.
SPRING_PROFILES_ACTIVE=local
KANGBAN_DB_USERNAME=root
KANGBAN_DB_PASSWORD=YOUR_MYSQL_PASSWORD
KANGBAN_REDIS_PASSWORD=YOUR_REDIS_PASSWORD
KANGBAN_MINIO_ENDPOINT=http://localhost:9000
KANGBAN_MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
KANGBAN_MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
KANGBAN_JWT_SECRET=YOUR_BASE64_ENCODED_64_BYTE_SECRET
KANGBAN_CAPTCHA_SECRET=YOUR_RANDOM_CAPTCHA_HMAC_SECRET

APP_BASE_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_AI_PROVIDER=qwen
APP_AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
APP_AI_API_KEY=YOUR_DASHSCOPE_API_KEY
APP_AI_AI_MODEL=qwen3.7-plus-2026-05-26
APP_AI_OCR_MODEL=qwen3.5-ocr
APP_AI_CONNECT_TIMEOUT=10000
APP_AI_READ_TIMEOUT=120000

APP_AGENT_ENABLED=true
APP_AGENT_MODEL_TOOL_CALLING_ENABLED=false
APP_AGENT_CONTEXT_TTL_SECONDS=300
APP_AGENT_MAX_ITERATIONS=5
APP_AGENT_MAX_HISTORY_MESSAGES=12
APP_AGENT_MAX_HISTORY_TOKENS=6000
APP_AGENT_MAX_HISTORY_MESSAGE_CHARACTERS=4000
APP_AGENT_CORE_POOL_SIZE=2
APP_AGENT_MAX_POOL_SIZE=4
APP_AGENT_QUEUE_CAPACITY=20
APP_AGENT_CONTEXT_SECRET=YOUR_INTERNAL_AGENT_HMAC_SECRET
APP_RAG_ENABLED=false
APP_RAG_PRIVATE_ENABLED=true
APP_RAG_VECTOR_STORE=memory
APP_RAG_TOP_K=5
APP_RAG_MIN_SCORE=0.7
APP_RAG_MAX_CONTEXT_TOKENS=6000
APP_KNOWLEDGE_ADMIN_TOKEN=YOUR_KNOWLEDGE_ADMIN_TOKEN
APP_RAG_EMBEDDING_PROVIDER=local
APP_RAG_EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
APP_RAG_EMBEDDING_MODEL=local-hash-v1
APP_RAG_EMBEDDING_DIMENSIONS=128
APP_RAG_EMBEDDING_BATCH_SIZE=16
APP_RAG_MAX_FILE_BYTES=10485760
