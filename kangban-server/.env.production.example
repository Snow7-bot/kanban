# Production template. Copy outside the repository and replace every placeholder.
SPRING_PROFILES_ACTIVE=prod

KANGBAN_DB_URL=jdbc:mysql://mysql.internal:3306/kangban?useSSL=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
KANGBAN_DB_USERNAME=YOUR_DB_USERNAME
KANGBAN_DB_PASSWORD=YOUR_DB_PASSWORD

KANGBAN_REDIS_HOST=redis.internal
KANGBAN_REDIS_PORT=6379
KANGBAN_REDIS_PASSWORD=YOUR_REDIS_PASSWORD

KANGBAN_MINIO_ENDPOINT=https://files.example.com
KANGBAN_MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
KANGBAN_MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
KANGBAN_MINIO_BUCKET=kangban-files

KANGBAN_JWT_SECRET=YOUR_BASE64_ENCODED_64_BYTE_SECRET
KANGBAN_JWT_EXPIRATION=86400000
KANGBAN_JWT_REFRESH_EXPIRATION=604800000
KANGBAN_CAPTCHA_SECRET=YOUR_RANDOM_CAPTCHA_HMAC_SECRET

APP_BASE_URL=https://app.example.com
APP_CORS_ALLOWED_ORIGINS=https://app.example.com

APP_AI_PROVIDER=qwen
APP_AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
APP_AI_API_KEY=YOUR_DASHSCOPE_API_KEY
APP_AI_AI_MODEL=YOUR_QWEN_CHAT_MODEL
APP_AI_OCR_MODEL=YOUR_QWEN_OCR_MODEL
APP_AI_CONNECT_TIMEOUT=10000
APP_AI_READ_TIMEOUT=60000
